generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // delete folder genereated lalu genereate ulang dan + src/generated/prisma
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Kategori {
  id    Int     @id @default(autoincrement())
  nama  String  @db.VarChar(20)
}
